---
import "../styles/global.css";
import work from "../../content/selected-work.json";
import ProjectCard from "../components/ProjectCard.astro";
---
<!doctype html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Salim Braksa — Portfolio layout draft</title><script is:inline src="/assets/js/theme.js"></script><link rel="canonical" href="https://salimbraksa.github.io/">
<meta property="og:type" content="website">
<meta property="og:title" content="Salim Braksa — iOS Engineer">
<meta property="og:description" content="Thoughtful interfaces. Reliable experiences. Explore my work on Moment, HungerStation, Sainsbury’s, and more.">
<meta property="og:url" content="https://salimbraksa.github.io/">
<meta property="og:image" content="https://salimbraksa.github.io/assets/images/social/social-portrait.png">
<meta property="og:image:width" content="800">
<meta property="og:image:height" content="800">
<meta property="og:image:alt" content="Portrait of Salim Braksa">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Salim Braksa — iOS Engineer">
<meta name="twitter:description" content="Explore my iOS work on Moment, HungerStation, Sainsbury’s, and more.">
<meta name="twitter:image" content="https://salimbraksa.github.io/assets/images/social/social-portrait.png">
</head><body><main>
<header><span class="brand">Salim Braksa.</span><nav><a href="#work">Work</a><a href="#contact">Contact</a><div class="theme-switch" role="group" aria-label="Color theme"><button type="button" data-theme-choice="system" aria-label="System theme" title="System" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg></button><button type="button" data-theme-choice="light" aria-label="Light theme" title="Light" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button><button type="button" data-theme-choice="dark" aria-label="Dark theme" title="Dark" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z"/></svg></button></div></nav></header>
<section class="hero"><div><h1>Hi, I’m Salim <span role="img" aria-label="Waving hand">👋</span></h1><p>I’m an iOS engineer from Morocco <span role="img" aria-label="Moroccan flag">🇲🇦</span> with <span id="experience-years">{new Date().getFullYear() - 2018}</span> years of experience and a passion for building polished user interfaces. My experience includes work with Automattic, HungerStation, and Sainsbury’s.</p><div class="buttons"><a class="button primary" href="#work">Explore my work ↓</a><a class="button" href="#contact">Get in touch</a></div></div><img class="monogram github-avatar" src="https://avatars.githubusercontent.com/u/9609223?v=4" alt="Salim Braksa" width="210" height="210"></section>
<section id="work"><div class="section-head"><h2>Featured projects</h2></div>
{work.projects.map((app) => <ProjectCard app={app} />)}
</section><section class="more"><h2>Also worked on</h2><div class="more-row"><div class="other-app"><img class="app-icon" src="https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/b9/50/93/b9509376-0531-a7b7-2a12-73192f709db0/AppIconLegacy-0-0-1x_U007epad-0-0-0-1-0-0-sRGB-85-220.png/512x512bb.jpg" alt="" width="48" height="48" loading="lazy"><div><strong>WordPress</strong><p>Create and manage WordPress websites, write posts, and publish on the go.</p></div></div><a href="https://apps.apple.com/us/app/wordpress-website-builder/id335703880">View app ↗</a></div><div class="more-row"><div class="other-app"><img class="app-icon" src="https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/7e/c0/fe/7ec0fea6-f5ba-84f4-91fd-8e6192a10fdf/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-0-85-220.png/512x512bb.jpg" alt="" width="48" height="48" loading="lazy"><div><strong>Argos</strong><p>Shopping for technology, home essentials, toys, and more.</p></div></div><a href="https://apps.apple.com/gb/app/argos-shop-tech-toys-more/id370371087">View app ↗</a></div><div class="more-row"><div class="other-app"><img class="app-icon" src="https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/69/95/7a/69957a6c-3c1f-4e55-e502-1d4511ff1300/AppIcon-0-0-1x_U007emarketing-0-6-0-85-220.png/512x512bb.jpg" alt="" width="48" height="48" loading="lazy"><div><strong>Liven</strong><p>Restaurant payments and dining rewards.</p></div></div><a href="https://apps.apple.com/au/app/liven-eat-pay-earn/id857653005">View app ↗</a></div></section>
<footer class="contact-footer" id="contact"><div class="contact"><div><h2>Let’s talk.</h2><p>Have a project in mind or an opportunity to share? I’d love to hear from you.</p></div><div class="contact-stack"><a class="contact-row" href="https://github.com/salimbraksa"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1-4-2-6-2m12 5v-4a3 3 0 0 0-1-2c3-.3 6-1.5 6-6a5 5 0 0 0-1-3.5 4 4 0 0 0-.1-3.5S17.5 2.5 15 4a13 13 0 0 0-6 0C6.5 2.5 5.1 3 5.1 3A4 4 0 0 0 5 6.5 5 5 0 0 0 4 10c0 4.5 3 5.7 6 6a3 3 0 0 0-1 2v4"/></svg><span>GitHub</span></a><a class="contact-row" href="mailto:salim.braksa@gmail.com"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg><span>Email</span></a><a class="contact-row" href="https://www.linkedin.com/in/salimbraksa/"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7M7 7v.01M11 17v-7m0 3a3 3 0 0 1 6 0v4"/></svg><span>LinkedIn</span></a><a class="contact-row" href="/assets/documents/resume_salim_braksa_main.pdf" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 12h8M8 16h8"/></svg><span>Résumé</span></a></div></div><div class="copyright">© <span id="copyright-year">{new Date().getFullYear()}</span> Salim Braksa</div></footer>
</main><script is:inline src="/assets/js/main.js"></script></body></html>
